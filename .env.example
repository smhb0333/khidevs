# Public canonical site URL used for SEO metadata and the generated sitemap.
# Current GitHub Pages deployment:
VITE_SITE_URL=https://smhb0333.github.io/khidevs

# Production path used by Vite/React Router.
# Keep /khidevs/ for GitHub Pages. Change to / when the site is deployed at the root of www.khidevs.com.
VITE_BASE_PATH=/khidevs/

# Optional production contact-form endpoint.
# Leave blank for local/offline testing; submissions are saved to browser localStorage.
VITE_CONTACT_ENDPOINT=
